{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whisper-hands.local/schemas/device-event.json",
  "title": "Whisper Hands Device Event",
  "type": "object",
  "required": ["schema_version", "event_id", "device_id", "type", "occurred_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 8 },
    "device_id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["MARK_PRESSED", "SESSION_STARTED", "SESSION_ENDED", "MATERIAL_SELECTED", "DEVICE_HEARTBEAT"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "properties": {
        "project_id": { "type": ["string", "null"] },
        "template_id": { "type": ["string", "null"] },
        "press_duration_ms": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
